# Copy to .env and fill in. .env is gitignored and must never be committed.
# Placeholder values only in this file.
#
# Every name here is read in src/config/__init__.py and nowhere else. If a
# setting is not in this file it is not a setting.

GEMINI_API_KEY=your-key-here
GEMINI_LIVE_MODEL=gemini-3.8-live

# Which prebuilt voice the agent speaks in. Unset leaves the API's own
# default - which is a liability now that the opening line is a RECORDING of
# this voice (src/agent/greeting.pcm): a default that moves makes the
# greeting a different person from the rest of the call. Name it, and the
# two cannot drift.
#
# Re-run `make greeting` after changing this. Until you do, the recording is
# of the OLD voice and every call opens in it.
# VOICE_NAME=Kore

# Grok writes a short text handover every N caller replies, after the reply,
# so a rotated Live socket does not have to keep the old audio. Off leaves
# the tool note exactly as it was. The key is a header, never a URL, and it
# is optional: with the flag on and the key empty, summaries stay off and
# the call still runs.
# GROK_MEMORY=1
# XAI_API_KEY=your-xai-key-here
# GROK_MODEL=grok-4.3
# Cheaper on the same key, same short-context card as 4.3:
# GROK_MODEL=grok-4.20-0309-non-reasoning
# GROK_SUMMARY_EVERY_TURNS=4
# GROK_TIMEOUT_SECONDS=4

# A SECOND ear on the call, for measurement only. Whisper on GROQ - a
# different company from xAI's Grok above, one letter apart, its own key,
# and neither is a fallback for the other. On, it transcribes the same
# frames the Live API hears and writes both transcripts to the call trace;
# it answers nobody and delays nothing. This is the measurement step 3 of
# docs/CASCADE.md has to be decided on, and it costs about 7 paise a minute
# while it is on - so leave it off unless a call is being measured.
# WHISPER_COMPARE=1
# GROQ_API_KEY=your-groq-key-here
# WHISPER_MODEL=whisper-large-v3-turbo
# WHISPER_TIMEOUT_SECONDS=8

# The whole conversation off native audio: Whisper for the ear, the chat
# tab's own text session for the brain, and the Live socket demoted to a
# mouth that is only ever handed the finished reply. Nothing the caller says
# enters any model's context as audio, so none of it is re-billed on the
# turn after - about Rs 3.07 a minute down to Rs 1.80.
#
# IT IS SLOWER. Roughly 1.3 seconds more on every turn the customer waits
# through, because three models answer in series where one did. Run it
# against real calls and listen before believing the table.
#
# The ear is xAI's STT on XAI_API_KEY above - the key the summariser already
# uses, so no second vendor. Groq's Whisper is the alternative and is used
# only when XAI_API_KEY is empty and GROQ_API_KEY is not.
#
# It transcribes into TAMIL SCRIPT and writes numbers as words:
# "இருபதாயிரம்", with no digit in it. The brain reads that correctly - it
# called search_products with max_price 25000 - but prefetch.py reads digits
# with a regular expression and finds nothing, so the prefetch does not fire
# on this path yet.
# STT_MODEL=grok-voice-transcribe-2.0
# STT_LANGUAGE=ta
#
# WHISPER_COMPARE and CASCADE are different things: the first listens and
# measures, the second answers. Measure first.
# CASCADE=1

# Chat runs on a cheaper text model - the Live model is speech-to-speech and
# billing text through it buys nothing. See ../CHAT-PLAN.md.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# A ceiling for the rare answer that needs it, NOT a target. An avoided turn
# is worth several seconds of speech, so a reply clipped short enough that the
# customer asks again costs more than the full answer. See docs/COST.md.
#
# These MUST match src/config/*.py, because an env var set here silently wins
# over the shipped default. This file said 100 while both configs said 15,
# so anyone who copied it ran at nearly seven times the modelled reply
# length and the shipped figure described a config nobody was running.
#
# 18 is the measured choice: enough for two products, a reason each and one
# question, at +Rs 0.24 a connected minute. 25 was tried first and cost
# Rs 0.79. The arithmetic is in src/config/prodconfig.py, beside the number.
REPLY_WORD_CAP=18
CHAT_WORD_CAP=45

# 0 disables thinking. The Live model rejects the field outright and bills for
# thinking anyway; this is honoured by the text model only.
THINKING_BUDGET=0

# Telephony audio is 8 kHz; the model wants 16 kHz in and emits 24 kHz.
CAPTURE_SAMPLE_RATE=16000
PLAYBACK_SAMPLE_RATE=24000

# Context window compression. Probed, not reasoned: below ~2,500 the agent
# stops remembering the call, and at 400 the API closes the socket on the
# first tool call. src/config/devconfig.py carries the measurements.
CONTEXT_TRIGGER_TOKENS=3000
CONTEXT_TARGET_TOKENS=2400

# Session rotation, which does what compression cannot: once this much
# caller+agent audio is being re-billed every generation, move the call to a
# fresh socket and hand it a few sentences of TEXT instead. 600 tokens is
# about twenty-four seconds of retained speech. Zero leaves one socket for
# the whole call. src/voice/rotating.py explains it.
ROTATE_ABOVE_AUDIO_TOKENS=600

# Cost reporting. Both are assumptions, not measurements - override per review.
USD_INR=89.0
GST_RATE=0.18

# Two different numbers. The target is what a connected minute is supposed to
# cost and is what the screen is coloured against; the ceiling ends the
# session and is a runaway guard, set far above the target because hanging up
# on a customer mid-sentence does not refund the rupee.
TARGET_INR_PER_MINUTE=2.50
MAX_INR_PER_MINUTE=8.00

# Session ceilings. A Google Cloud budget is an alert and keeps billing past
# its threshold; these end the session. The rupee one is the backstop - if it
# is what stops a call, the other two are set wrong.
MAX_SESSION_TURNS=40
MAX_SESSION_MINUTES=10
MAX_SESSION_INR=50

# Product List API. The token is a secret and belongs here, never in the
# browser and never in /api/v1/config.
CATALOGUE_URL=https://stage-proxy.poorvika.in/<path>
CATALOGUE_TOKEN=your-access-token-here
CATALOGUE_ORIGIN=bot

# Which build this is. Set by the Dockerfile at build time, not by hand -
# it is here so the list of names src/config reads stays complete. Outside a
# built image it reports "unknown", which is itself the right answer.
# APP_RELEASE=

# Where errors go, as well as to the log. EMPTY by default and that is a
# decision, not an oversight: sending error reports to a third party is data
# processing and it is Poorvika's call. With a DSN set, reports go to Sentry
# AS WELL AS the log - never instead, because the log is the copy that stays
# in the country the call happened in. The payload is scrubbed first; see
# src/observability/scrub.py for what never leaves.
#
# The SDK is optional and is not in requirements.txt. A deployment that
# wants this installs `sentry-sdk` and sets this.
# SENTRY_DSN=

# Guards /metrics. Empty leaves it open, which is right for development and
# wrong for anywhere else: the numbers are not secrets but they ARE
# commercial, and how many calls Poorvika takes is not for a public URL. A
# wrong token gets a 404, not a 401 - an endpoint that announces itself as
# protected is one somebody now knows to attack.
# METRICS_TOKEN=

LOG_LEVEL=INFO

# Browsers allowed to call this server. Comma-separated, exact origins only -
# never "*", because the socket carries a live conversation.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# New calls accepted per client per minute. A voice session holds a socket
# open for minutes and costs real money, so the limit is low on purpose.
MAX_CALLS_PER_MINUTE=6

# -- per-item facts: price in force, stock, card offers, bank EMI -----------
#
# src/agent/tools/estate.py explains the two backends. "inprocess" runs the
# Search Blocks product service here and needs a checkout of it; "worker"
# calls POST /product on a deployed one; "off" turns per-item facts off and
# the agent says so rather than guessing.
ESTATE_BACKEND=inprocess
ESTATE_SRC_PATH=../../Search-proxy/products-search-engine
# ESTATE_WORKER_URL=https://search-proxy.poorvika.workers.dev/product
# ESTATE_WORKER_TOKEN=
#
# One environment, whole. Measured 2026-11-04: production answers price,
# offers and EMI and has no working stock credential; stage answers stock,
# holds test prices, and has no EMI host at all. Production pricing spoken
# beside staging stock is the failure this refuses to allow.
ESTATE_API_ENV=production
#
# These must be the tokens for ESTATE_API_ENV above - a stage host under
# production is refused rather than quietly mixed.
PIM_ACCESS_TOKEN=
OFFERS_API_KEY=
CI_AUTH_TOKEN=
# The CI gateway verifies its token with a secret chosen by this header, so
# the same token is accepted as `bot` and refused as `ai_bot` with a
# misleading "signature is invalid".
CI_MODE=
OFFERS_MODE=
# Set CI_HOST and CI_AUTH_TOKEN together, from the SAME folder of the API
# collection - the production token's payload matches staging's and only its
# signature differs, so a mixed pair fails as "signature is invalid" rather
# than as anything that names the real problem.
#
# A BASE URL, not a hostname: scheme and path included. A bare host is
# accepted by the config, reports `ready`, and then fails every call with
# "Request URL is missing an 'http://' or 'https://' protocol".
#
# Run `make estate ARGS=--live` after changing either. `ready` only means
# configured; the live half is what proves the token was accepted, and a
# refusal arrives with HTTP 200.
# CI_HOST=https://ci-gateway.poorvika.com/central-inv/v1
# EMI_HOST=
