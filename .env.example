# Copy to .env and fill in. .env is gitignored and must never be committed.
# Placeholder values only in this file.
#
# Every name here is read in src/config/__init__.py and nowhere else. If a
# setting is not in this file it is not a setting.

GEMINI_API_KEY=your-key-here
GEMINI_LIVE_MODEL=gemini-3.8-live

# Chat runs on a cheaper text model - the Live model is speech-to-speech and
# billing text through it buys nothing. See ../CHAT-PLAN.md.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# A ceiling for the rare answer that needs it, NOT a target. An avoided turn
# is worth several seconds of speech, so a reply clipped short enough that the
# customer asks again costs more than the full answer. See docs/COST.md.
REPLY_WORD_CAP=100
CHAT_WORD_CAP=100

# 0 disables thinking. The Live model rejects the field outright and bills for
# thinking anyway; this is honoured by the text model only.
THINKING_BUDGET=0

# Telephony audio is 8 kHz; the model wants 16 kHz in and emits 24 kHz.
CAPTURE_SAMPLE_RATE=16000
PLAYBACK_SAMPLE_RATE=24000

# Context window compression. Probed, not reasoned: below ~2,500 the agent
# stops remembering the call, and at 400 the API closes the socket on the
# first tool call. src/config/devconfig.py carries the measurements.
CONTEXT_TRIGGER_TOKENS=3000
CONTEXT_TARGET_TOKENS=2400

# Cost reporting. Both are assumptions, not measurements - override per review.
USD_INR=89.0
GST_RATE=0.18

# Two different numbers. The target is what a connected minute is supposed to
# cost and is what the screen is coloured against; the ceiling ends the
# session and is a runaway guard, set far above the target because hanging up
# on a customer mid-sentence does not refund the rupee.
TARGET_INR_PER_MINUTE=2.00
MAX_INR_PER_MINUTE=8.00

# Session ceilings. A Google Cloud budget is an alert and keeps billing past
# its threshold; these end the session. The rupee one is the backstop - if it
# is what stops a call, the other two are set wrong.
MAX_SESSION_TURNS=40
MAX_SESSION_MINUTES=10
MAX_SESSION_INR=50

# Product List API. The token is a secret and belongs here, never in the
# browser and never in /api/v1/config.
CATALOGUE_URL=https://stage-proxy.poorvika.in/<path>
CATALOGUE_TOKEN=your-access-token-here
CATALOGUE_ORIGIN=bot

# Which build this is. Set by the Dockerfile at build time, not by hand -
# it is here so the list of names src/config reads stays complete. Outside a
# built image it reports "unknown", which is itself the right answer.
# APP_RELEASE=

LOG_LEVEL=INFO

# Browsers allowed to call this server. Comma-separated, exact origins only -
# never "*", because the socket carries a live conversation.
ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# New calls accepted per client per minute. A voice session holds a socket
# open for minutes and costs real money, so the limit is low on purpose.
MAX_CALLS_PER_MINUTE=6

# -- per-item facts: price in force, stock, card offers, bank EMI -----------
#
# src/agent/tools/estate.py explains the two backends. "inprocess" runs the
# Search Blocks product service here and needs a checkout of it; "worker"
# calls POST /product on a deployed one; "off" turns per-item facts off and
# the agent says so rather than guessing.
ESTATE_BACKEND=inprocess
ESTATE_SRC_PATH=../../Search-proxy/products-search-engine
# ESTATE_WORKER_URL=https://search-proxy.poorvika.workers.dev/product
# ESTATE_WORKER_TOKEN=
#
# One environment, whole. Measured 2026-11-04: production answers price,
# offers and EMI and has no working stock credential; stage answers stock,
# holds test prices, and has no EMI host at all. Production pricing spoken
# beside staging stock is the failure this refuses to allow.
ESTATE_API_ENV=production
#
# These must be the tokens for ESTATE_API_ENV above - a stage host under
# production is refused rather than quietly mixed.
PIM_ACCESS_TOKEN=
OFFERS_API_KEY=
CI_AUTH_TOKEN=
# The CI gateway verifies its token with a secret chosen by this header, so
# the same token is accepted as `bot` and refused as `ai_bot` with a
# misleading "signature is invalid".
CI_MODE=
OFFERS_MODE=
# Set together, and only once Poorvika issues a production pair. Until then
# stock reports that it could not be checked, which is the truth.
# CI_HOST=
# EMI_HOST=
