# Copy to .env and fill in. .env is gitignored and must never be committed.
# Placeholder values only in this file.

GEMINI_API_KEY=your-key-here
GEMINI_LIVE_MODEL=gemini-3.8-live

# Chat runs on a cheaper text model - the Live model is speech-to-speech and
# billing text through it buys nothing. See CHAT-PLAN.md.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite

# Measured in Phase 0: a 15-word cap roughly halves reply tokens against 25,
# and output audio is the largest single cost line. See docs/COST-NOTES.md.
REPLY_WORD_CAP=15

# Chat can afford more words: a reader skims, a listener cannot, and text
# output bills at $2.50/1M against $12.00 for audio.
CHAT_WORD_CAP=45

# Measured in Phase 0: 0 disables thinking entirely. Thinking is billed but is
# absent from totalTokenCount, so it hides from naive metering.
THINKING_BUDGET=0

# Telephony audio is 8 kHz; the model wants 16 kHz in and emits 24 kHz.
CAPTURE_SAMPLE_RATE=16000
PLAYBACK_SAMPLE_RATE=24000

# Cost reporting. Both are assumptions, not measurements - override per review.
USD_INR=89.0
GST_RATE=0.18

# Session ceilings. A Google Cloud budget is an alert and keeps billing past
# its threshold; these end the session. The rupee one is the backstop - if it
# is what stops a call, the other two are set wrong.
MAX_SESSION_TURNS=40
MAX_SESSION_MINUTES=10
MAX_SESSION_INR=20

LOG_LEVEL=INFO
